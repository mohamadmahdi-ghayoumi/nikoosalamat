Options -Indexes
RewriteEngine On

# Temporary: prevent search engines from indexing the site before launch.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  # SPA entry pages must revalidate after a release, including rewritten routes.
  # Versioned JS/CSS and images keep their normal caching behavior.
  <Files "index.html">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>
</IfModule>

# Never expose application data or configuration files.
RewriteRule ^app(?:/|$) - [F,L,NC]
RewriteRule ^config\.php$ - [F,L,NC]

# Retire the predictable login URL without revealing the replacement.
RewriteRule ^admin(?:/|$) - [R=404,L,NC]

# The magazine index moved; preserve all existing article detail URLs.
RewriteRule ^articles/?$ /mag/ [R=301,L,NC]

# Serve real assets and uploaded images directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route every API endpoint to the PHP front controller.
RewriteRule ^api(?:/.*)?$ api.php [QSA,L,NC]
RewriteRule ^sitemap\.xml$ api.php [L,NC]

# React client-side routes, including the unlisted management page.
RewriteRule ^ index.html [L]
