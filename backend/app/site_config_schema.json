{
  "config":{"type":"object","fields":{"theme":"theme","texts":"texts","images":"images","links":"links","navigation":"navigation","footerMenus":"footerMenus","layouts":"layouts","blocks":"blocks","slides":"slides","pages":"pages"}},
  "theme":{"type":"object","fields":{"primary":"color","primaryDark":"color","background":"color","paper":"color","text":"color","muted":"color","line":"color","header":"color","footer":"color","navigationText":"color","font":"font","heading":"sizes","body":"sizes","cards":"sizes","navigation":"sizes","radius":"radius","contentWidth":"contentWidth"}},
  "color":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$","max":7},
  "font":{"type":"string","choices":["digikala","tahoma","arial"]},
  "sizes":{"type":"object","fields":{"desktop":"fontSize","tablet":"fontSize","mobile":"fontSize"}},
  "fontSize":{"type":"integer","min":10,"max":80},
  "radius":{"type":"integer","min":0,"max":40},
  "contentWidth":{"type":"integer","min":960,"max":1600},
  "texts":{"type":"map","item":"text","max":500,"keyPattern":"^[a-zA-Z0-9_.-]{1,120}$"},
  "text":{"type":"object","fields":{"text":"longText","color":"color","sizes":"sizes","weight":"weight","align":"align","font":"font"}},
  "weight":{"type":"string","choices":["inherit","400","500","700","900"]},
  "align":{"type":"string","choices":["inherit","right","center","left"]},
  "longText":{"type":"string","max":12000},
  "title":{"type":"string","max":300},
  "label":{"type":"string","min":1,"max":100},
  "images":{"type":"map","item":"image","max":150,"keyPattern":"^[a-zA-Z0-9_.-]{1,120}$"},
  "image":{"type":"object","fields":{"url":"imageUrl","alt":"title","fit":"fit","width":"percent"},"required":["url"]},
  "imageUrl":{"type":"string","max":1000,"format":"imageUrl"},
  "url":{"type":"string","max":1000,"format":"url"},
  "fit":{"type":"string","choices":["cover","contain"]},
  "percent":{"type":"integer","min":10,"max":100},
  "links":{"type":"map","item":"url","max":150,"keyPattern":"^[a-zA-Z0-9_.-]{1,120}$"},
  "navigation":{"type":"array","item":"navItem","max":30},
  "navItem":{"type":"object","fields":{"label":"label","path":"url","children":"navigation","activePaths":"paths"},"required":["label","path"]},
  "paths":{"type":"array","item":"url","max":20},
  "footerMenus":{"type":"object","fields":{"solutions":"navigation","guide":"navigation"}},
  "layouts":{"type":"object","fields":{"home":"sections","about":"sections","contact":"sections"}},
  "sections":{"type":"array","item":"sectionId","max":40},
  "sectionId":{"type":"string","pattern":"^[a-z0-9-]{1,80}$","max":80},
  "blocks":{"type":"map","item":"block","max":100,"keyPattern":"^[a-z0-9-]{1,80}$"},
  "block":{"type":"object","fields":{"title":"title","body":"html","image":"imageUrl","alt":"title","action":"title","path":"url","layout":"blockLayout","background":"color"}},
  "blockLayout":{"type":"string","choices":["text","image","split"]},
  "html":{"type":"string","max":60000},
  "slides":{"type":"array","item":"slide","max":30},
  "slide":{"type":"object","fields":{"id":"sectionId","title":"title","text":"longText","action":"label","path":"url","image":"imageUrl","alt":"title","layout":"slideLayout","enabled":"boolean","fit":"fit"},"required":["id","image","title","text","action","path","layout"]},
  "slideLayout":{"type":"string","choices":["panoramic","poster"]},
  "boolean":{"type":"boolean"},
  "pages":{"type":"map","item":"page","max":50,"keyPattern":"^[a-z0-9][a-z0-9-]{1,79}$"},
  "page":{"type":"object","fields":{"title":"title","description":"longText","sections":"sections"},"required":["title","sections"]}
}
